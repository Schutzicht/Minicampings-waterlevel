---
interface Props {
  class?: string;
  variant?: 'full' | 'mark';
  invert?: boolean;
}
const { class: cls = '', variant = 'full', invert = false } = Astro.props;
const wordColor = invert ? 'text-white' : 'text-ink';
const subColor = invert ? 'text-white/55' : 'text-faint';
---
<span class={`inline-flex items-center gap-2.5 ${cls}`}>
  <span class="water-grad relative grid h-9 w-9 place-items-center rounded-[11px] shadow-[0_6px_16px_-6px_rgba(14,124,134,0.7)]">
    <svg width="19" height="19" viewBox="0 0 24 24" fill="white" aria-hidden="true">
      <path d="M12 3.2c4 4.4 6.5 7.6 6.5 11A6.5 6.5 0 0 1 5.5 14.2c0-3.4 2.5-6.6 6.5-11z" opacity="0.95"/>
      <path d="M9 14.6c0 1.7 1.4 3 3 3" fill="none" stroke="rgba(11,61,73,0.45)" stroke-width="1.6" stroke-linecap="round"/>
    </svg>
  </span>
  {variant === 'full' && (
    <span class="leading-none">
      <span class={`font-display text-[1.32rem] font-extrabold tracking-tight ${wordColor}`}>Peil</span>
      <span class={`block text-[0.62rem] font-semibold uppercase tracking-[0.2em] ${subColor}`}>watermonitoring</span>
    </span>
  )}
</span>
