---
interface Props {
  class?: string;
  variant?: 'full' | 'mark';
  size?: number;
  invert?: boolean;
}
const { class: cls = '', variant = 'full', size = 30, invert = false } = Astro.props;
const wordColor = invert ? 'text-white' : 'text-[var(--color-ink)]';
const subColor = invert ? 'text-white/55' : 'text-[var(--color-ink-3)]';
---
<span class={`inline-flex items-center gap-2.5 ${cls}`}>
  <span
    class="relative grid shrink-0 place-items-center rounded-[9px] bg-[var(--color-ink)]"
    style={`height:${size}px;width:${size}px`}
  >
    <svg width={size * 0.6} height={size * 0.6} viewBox="0 0 24 24" fill="white" aria-hidden="true">
      <path d="M12 3.4c4 4.3 6.3 7.4 6.3 10.8A6.3 6.3 0 0 1 5.7 14.2c0-3.4 2.3-6.5 6.3-10.8z" opacity="0.96" />
      <path d="M9.2 14.6c0 1.6 1.3 2.9 2.9 2.9" fill="none" stroke="#1d1d1b" stroke-width="1.5" stroke-linecap="round" opacity="0.5" />
    </svg>
    <span class="absolute -right-0.5 -top-0.5 h-2 w-2 rounded-full bg-[var(--color-accent)] ring-2 ring-[var(--color-bg)]"></span>
  </span>
  {variant === 'full' && (
    <span class="flex flex-col leading-none">
      <span class={`text-[16px] font-semibold tracking-tight ${wordColor}`}>Peil</span>
      <span class={`mt-1 text-[10px] font-medium uppercase tracking-[0.14em] ${subColor}`}>Watermonitoring</span>
    </span>
  )}
</span>
