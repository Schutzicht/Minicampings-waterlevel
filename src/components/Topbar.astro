---
import Logo from './Logo.astro';

interface Props {
  title?: string;
  subtitle?: string;
}
const { title, subtitle } = Astro.props;
---
<header class="glass sticky top-0 z-30 flex h-14 items-center justify-between gap-3 border-b border-[var(--color-border)] px-4 sm:px-5">
  <div class="flex min-w-0 flex-1 items-center gap-3">
    <a href="/" class="md:hidden" aria-label="Peil home"><Logo variant="mark" size={28} /></a>
    {title && (
      <div class="min-w-0">
        <h1 class="truncate text-[15px] font-semibold tracking-tight text-[var(--color-ink)]">{title}</h1>
        {subtitle && <p class="hidden truncate text-[11.5px] text-[var(--color-ink-3)] sm:block">{subtitle}</p>}
      </div>
    )}
  </div>

  <div class="flex items-center gap-2 sm:gap-2.5">
    <a
      href="/invoer"
      id="weekPill"
      class="hidden items-center gap-1.5 rounded-[10px] border border-[var(--color-border)] bg-[var(--color-surface)] px-2.5 py-1.5 text-[12px] font-medium text-[var(--color-ink-2)] transition-colors hover:border-[var(--color-border-strong)] hover:text-[var(--color-ink)] sm:inline-flex"
    >
      <span class="h-2 w-2 rounded-full bg-[var(--color-warn)]"></span>
      <span class="tnum">Deze week</span>
    </a>

    <a href="/instellingen" aria-label="Instellingen" class="flex h-9 w-9 items-center justify-center rounded-[10px] border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-ink-2)] transition-colors hover:border-[var(--color-border-strong)] hover:text-[var(--color-ink)] md:hidden">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm7-3a7 7 0 0 0-.1-1.2l2-1.6-2-3.5-2.4.9a7 7 0 0 0-2-1.2L14 3h-4l-.5 2.4a7 7 0 0 0-2 1.2l-2.4-.9-2 3.5 2 1.6a7 7 0 0 0 0 2.4l-2 1.6 2 3.5 2.4-.9a7 7 0 0 0 2 1.2L10 21h4l.5-2.4a7 7 0 0 0 2-1.2l2.4.9 2-3.5-2-1.6a7 7 0 0 0 .1-1.2z"/></svg>
    </a>

    <slot name="action" />

    <a id="roleChip" href="/login" title="Wissel van account" class="flex items-center gap-2 rounded-[10px] border border-[var(--color-border)] bg-[var(--color-surface)] py-1 pl-1 pr-2.5 transition-colors hover:border-[var(--color-border-strong)]">
      <span id="roleAvatar" class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-[var(--color-ink)] text-[11px] font-semibold text-white">RZ</span>
      <span class="hidden flex-col leading-none sm:flex">
        <span id="roleName" class="text-[12px] font-medium text-[var(--color-ink)]">Regio Zeeland</span>
        <span id="roleSub" class="mt-0.5 text-[10px] uppercase tracking-wider text-[var(--color-ink-3)]">Beheerder</span>
      </span>
      <svg class="h-4 w-4 text-[var(--color-ink-3)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-label="Wissel account"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>
    </a>
  </div>
</header>
