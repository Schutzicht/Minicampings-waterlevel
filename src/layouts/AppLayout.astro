---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import Topbar from '../components/Topbar.astro';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  subtitle?: string;
  active: 'dashboard' | 'invoer' | 'campings' | 'analyse' | 'homewizard';
  description?: string;
  eyebrow?: string;
  hideHeader?: boolean;
}
const { title, subtitle, active, description } = Astro.props;

const mobileNav = [
  { key: 'dashboard', label: 'Dashboard', href: '/dashboard', icon: 'dashboard' },
  { key: 'invoer', label: 'Invoer', href: '/invoer', icon: 'invoer' },
  { key: 'campings', label: 'Campings', href: '/campings', icon: 'tent' },
  { key: 'analyse', label: 'Analyse', href: '/analyse', icon: 'chart' },
  { key: 'homewizard', label: 'HomeWizard', href: '/homewizard', icon: 'homewizard' },
];
---
<!doctype html>
<html lang="nl" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description ?? 'Peil - watermonitoring voor minicampings in de regio.'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title} · Peil</title>
  </head>
  <body class="min-h-full">
    <Sidebar active={active} />

    <div class="flex min-h-screen flex-col md:pl-16">
      <Topbar title={title} subtitle={subtitle}>
        <slot name="actions" slot="action" />
      </Topbar>

      <main class="flex-1">
        <div class="mx-auto w-full max-w-7xl px-4 py-6 pb-28 sm:px-6 sm:py-8 md:pb-12">
          <slot />
        </div>
      </main>
    </div>

    <!-- Mobiele onderbalk -->
    <nav class="fixed inset-x-0 bottom-0 z-40 border-t border-[var(--color-border)] bg-[var(--color-surface)] md:hidden" style="padding-bottom:env(safe-area-inset-bottom)">
      <div class="grid grid-cols-5">
        {mobileNav.map((item) => (
          <a
            href={item.href}
            aria-current={active === item.key ? 'page' : undefined}
            class={`flex flex-col items-center gap-1 py-2.5 text-[0.62rem] font-medium transition-colors ${
              active === item.key ? 'text-[var(--color-ink)]' : 'text-[var(--color-faint)]'
            }`}
          >
            <Icon name={item.icon} size={21} />
            {item.label}
          </a>
        ))}
      </div>
    </nav>

    <div id="toast" class="pointer-events-none fixed inset-x-0 bottom-24 z-50 flex justify-center px-4 md:bottom-8"></div>

    <script>
      import { currentWeekStatus, resetDemo } from '../lib/store';

      function paintWeekPill() {
        const el = document.getElementById('weekPill');
        if (!el) return;
        const s = currentWeekStatus();
        const total = s.ingevuld.length + s.open.length;
        const done = s.ingevuld.length;
        const complete = s.open.length === 0;
        el.innerHTML = `
          <span class="h-2 w-2 rounded-full ${complete ? 'bg-[var(--color-good)]' : 'bg-[var(--color-warn)]'}"></span>
          <span class="tnum">Week ${s.week} · ${done}/${total}</span>`;
      }
      paintWeekPill();
      window.addEventListener('peil:change', paintWeekPill);

      document.querySelectorAll('[data-reset]').forEach((b) =>
        b.addEventListener('click', () => {
          if (confirm('Demo-data terugzetten naar de uitgangssituatie?')) {
            resetDemo();
            location.reload();
          }
        }),
      );

      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.isIntersecting && e.target.classList.add('is-in')),
        { threshold: 0.1 },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      (window as any).peilToast = (msg: string) => {
        const wrap = document.getElementById('toast');
        if (!wrap) return;
        const t = document.createElement('div');
        t.className =
          'pointer-events-auto flex items-center gap-2 rounded-[10px] bg-[var(--color-ink)] px-4 py-2.5 text-[13px] font-medium text-white shadow-lift transition-all duration-300';
        t.style.opacity = '0';
        t.style.transform = 'translateY(8px)';
        t.innerHTML = `<span class="h-2 w-2 rounded-full bg-[var(--color-accent)]"></span>${msg}`;
        wrap.appendChild(t);
        requestAnimationFrame(() => {
          t.style.opacity = '1';
          t.style.transform = 'none';
        });
        setTimeout(() => {
          t.style.opacity = '0';
          t.style.transform = 'translateY(8px)';
          setTimeout(() => t.remove(), 320);
        }, 2600);
      };
    </script>
  </body>
</html>
