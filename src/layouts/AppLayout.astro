---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  eyebrow?: string;
  subtitle?: string;
  active: 'dashboard' | 'invoer' | 'campings' | 'analyse' | 'homewizard';
  description?: string;
  hideHeader?: boolean;
}
const { title, eyebrow, subtitle, active, description, hideHeader = false } = Astro.props;

const nav = [
  { key: 'dashboard', label: 'Dashboard', href: '/dashboard', icon: 'dashboard' },
  { key: 'invoer', label: 'Invoer', href: '/invoer', icon: 'invoer' },
  { key: 'campings', label: 'Campings', href: '/campings', icon: 'tent' },
  { key: 'analyse', label: 'Analyse', href: '/analyse', icon: 'chart' },
  { key: 'homewizard', label: 'HomeWizard', href: '/homewizard', icon: 'homewizard' },
];
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description ?? 'Peil - watermonitoring voor minicampings in de regio.'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;600;700;800&family=Inter:wght@400;450;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title} · Peil</title>
  </head>
  <body class="min-h-screen text-ink">
    <!-- Desktop sidebar -->
    <aside class="fixed inset-y-0 left-0 z-40 hidden w-64 flex-col border-r border-line bg-white lg:flex">
      <div class="px-5 pb-5 pt-6">
        <a href="/" aria-label="Naar home"><Logo /></a>
      </div>
      <nav class="flex-1 space-y-1 px-3">
        {nav.map((item) => (
          <a
            href={item.href}
            aria-current={active === item.key ? 'page' : undefined}
            class={`group flex items-center gap-3 rounded-xl px-3 py-2.5 text-[0.92rem] font-semibold transition-colors ${
              active === item.key ? 'bg-mist text-brand' : 'text-muted hover:bg-line-soft hover:text-deep'
            }`}
          >
            <Icon name={item.icon} size={19} class={active === item.key ? 'text-brand' : 'text-faint group-hover:text-brand'} />
            {item.label}
            {item.key === 'homewizard' && (
              <span class="ml-auto rounded-full bg-warn-soft px-1.5 py-0.5 text-[0.6rem] font-bold text-warn">SOON</span>
            )}
          </a>
        ))}
      </nav>
      <div class="m-3 rounded-xl border border-line bg-canvas p-3.5">
        <p class="text-[0.7rem] font-semibold uppercase tracking-wider text-faint">Regio</p>
        <p class="mt-0.5 text-sm font-semibold text-deep">Zeeland · pilot</p>
        <p class="mt-0.5 text-xs text-muted">6 minicampings aangesloten</p>
        <button data-reset class="mt-3 flex w-full items-center justify-center gap-1.5 rounded-lg border border-line bg-white py-1.5 text-xs font-semibold text-muted transition-colors hover:border-brand-400 hover:text-brand">
          Demo resetten
        </button>
      </div>
    </aside>

    <!-- Main column -->
    <div class="flex min-h-screen flex-col lg:pl-64">
      <!-- Topbar -->
      <header class="sticky top-0 z-30 border-b border-line bg-canvas/85 backdrop-blur-md">
        <div class="flex h-16 items-center justify-between gap-3 px-4 sm:px-6 lg:px-8">
          <a href="/" class="lg:hidden" aria-label="Naar home"><Logo /></a>
          <div class="hidden items-center gap-2 text-sm font-semibold text-muted lg:flex">
            <span class="chip bg-mist text-brand">Regio Zeeland</span>
            <Icon name="right" size={14} class="text-faint" />
            <span class="text-deep">{title}</span>
          </div>
          <div class="flex items-center gap-2.5">
            <a href="/invoer" id="weekPill" class="chip border border-line bg-white text-deep transition-colors hover:border-brand-400">
              <span class="h-2 w-2 rounded-full bg-warn"></span>
              <span class="tnum">Deze week</span>
            </a>
            <slot name="actions" />
          </div>
        </div>
      </header>

      <!-- Page content -->
      <main class="flex-1 px-4 pb-28 pt-7 sm:px-6 lg:px-8 lg:pb-14">
        <div class="mx-auto w-full max-w-6xl">
          {!hideHeader && (
            <div class="reveal">
              {eyebrow && <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand">{eyebrow}</p>}
              <h1 class="fluid-h2 mt-1 font-extrabold text-ink">{title}</h1>
              {subtitle && <p class="mt-2 max-w-2xl text-[0.98rem] leading-relaxed text-muted">{subtitle}</p>}
            </div>
          )}
          <div class={hideHeader ? '' : 'mt-7'}>
            <slot />
          </div>
        </div>
      </main>

      <footer class="border-t border-line px-4 py-6 sm:px-6 lg:px-8">
        <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-2 text-xs text-faint sm:flex-row">
          <p>Peil · demo watermonitoring · data lokaal in je browser</p>
          <div class="flex items-center gap-4">
            <button data-reset class="font-semibold text-muted hover:text-brand">Demo resetten</button>
            <span>Gebouwd door Agensea</span>
          </div>
        </div>
      </footer>
    </div>

    <!-- Mobile bottom tab bar -->
    <nav class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-white/95 backdrop-blur-md lg:hidden" style="padding-bottom:env(safe-area-inset-bottom)">
      <div class="grid grid-cols-5">
        {nav.map((item) => (
          <a
            href={item.href}
            aria-current={active === item.key ? 'page' : undefined}
            class={`flex flex-col items-center gap-1 py-2.5 text-[0.62rem] font-semibold transition-colors ${
              active === item.key ? 'text-brand' : 'text-faint'
            }`}
          >
            <Icon name={item.icon} size={21} />
            {item.label}
          </a>
        ))}
      </div>
    </nav>

    <!-- Toast -->
    <div id="toast" class="pointer-events-none fixed inset-x-0 bottom-24 z-50 flex justify-center px-4 lg:bottom-8"></div>

    <script>
      import { currentWeekStatus, resetDemo } from '../lib/store';

      // Live "deze week" pill
      function paintWeekPill() {
        const el = document.getElementById('weekPill');
        if (!el) return;
        const s = currentWeekStatus();
        const total = s.ingevuld.length + s.open.length;
        const done = s.ingevuld.length;
        const complete = s.open.length === 0;
        el.innerHTML = `
          <span class="h-2 w-2 rounded-full ${complete ? 'bg-good' : 'bg-warn'}"></span>
          <span class="tnum">Week ${s.week} · ${done}/${total} ingevuld</span>`;
      }
      paintWeekPill();
      window.addEventListener('peil:change', paintWeekPill);

      // Reset
      document.querySelectorAll('[data-reset]').forEach((b) =>
        b.addEventListener('click', () => {
          if (confirm('Demo-data terugzetten naar de uitgangssituatie?')) {
            resetDemo();
            location.reload();
          }
        }),
      );

      // Reveal on scroll
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.isIntersecting && e.target.classList.add('is-in')),
        { threshold: 0.12 },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // Toast helper available to pages
      (window as any).peilToast = (msg: string) => {
        const wrap = document.getElementById('toast');
        if (!wrap) return;
        const t = document.createElement('div');
        t.className =
          'pointer-events-auto flex items-center gap-2 rounded-xl bg-ink px-4 py-2.5 text-sm font-semibold text-white shadow-lift transition-all duration-300';
        t.style.opacity = '0';
        t.style.transform = 'translateY(8px)';
        t.innerHTML = `<span class="h-2 w-2 rounded-full bg-aqua"></span>${msg}`;
        wrap.appendChild(t);
        requestAnimationFrame(() => {
          t.style.opacity = '1';
          t.style.transform = 'none';
        });
        setTimeout(() => {
          t.style.opacity = '0';
          t.style.transform = 'translateY(8px)';
          setTimeout(() => t.remove(), 320);
        }, 2600);
      };
    </script>
  </body>
</html>
