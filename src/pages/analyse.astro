---
import AppLayout from '../layouts/AppLayout.astro';
import Icon from '../components/Icon.astro';
---
<AppLayout
  active="analyse"
  eyebrow="Vergelijken"
  title="Analyse"
  subtitle="Vergelijk je verbruik met dat van andere campings. Wat valt op en waar kun je bijsturen?"
>
  <section class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
    <div class="card p-4 sm:p-5">
      <p class="text-sm font-semibold text-muted">Zuinigste camping</p>
      <p id="a-best" class="mt-1.5 font-display text-lg font-semibold text-good">–</p>
      <p id="a-best-sub" class="text-xs text-faint"></p>
    </div>
    <div class="card p-4 sm:p-5">
      <p class="text-sm font-semibold text-muted">Regio gemiddelde</p>
      <p class="mt-1.5 flex items-baseline gap-1"><span id="a-avg" class="tnum font-display text-2xl font-semibold text-ink">–</span><span class="text-xs font-semibold text-faint">L/gast</span></p>
      <p class="text-xs text-faint">over het seizoen</p>
    </div>
    <div class="card p-4 sm:p-5">
      <p class="text-sm font-semibold text-muted">Totaal verbruik</p>
      <p class="mt-1.5 flex items-baseline gap-1"><span id="a-tot" class="tnum font-display text-2xl font-semibold text-ink">–</span><span class="text-xs font-semibold text-faint">m³</span></p>
      <p class="text-xs text-faint">alle campings, seizoen</p>
    </div>
    <div class="card p-4 sm:p-5">
      <p class="text-sm font-semibold text-muted">Totaal bezoekers</p>
      <p id="a-bez" class="mt-1.5 tnum font-display text-2xl font-semibold text-ink">–</p>
      <p class="text-xs text-faint">alle campings, seizoen</p>
    </div>
  </section>

  <section class="mt-4 card p-5 reveal">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="font-display text-lg font-bold text-ink">Liter per gast</h2>
        <p class="text-xs text-faint">Seizoensgemiddelde per camping · lager is zuiniger</p>
      </div>
      <span class="hidden items-center gap-3 text-xs font-semibold text-faint sm:flex">
        <span class="flex items-center gap-1"><span class="h-2.5 w-2.5 rounded-full" style="background:var(--color-good)"></span>Zuinig</span>
        <span class="flex items-center gap-1"><span class="h-2.5 w-2.5 rounded-full" style="background:var(--color-warn)"></span>Bovengem.</span>
        <span class="flex items-center gap-1"><span class="h-2.5 w-2.5 rounded-full" style="background:var(--color-high)"></span>Hoog</span>
      </span>
    </div>
    <div id="benchChart" class="mt-4"></div>
  </section>

  <section class="mt-4 reveal">
    <div class="mb-3 flex items-center gap-2">
      <Icon name="trend" size={18} class="text-brand" />
      <h2 class="font-display text-lg font-bold text-ink">Verbruik per week, per camping</h2>
    </div>
    <div id="smallMultiples" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3"></div>
  </section>

  <section class="mt-6 card overflow-hidden reveal">
    <div class="border-b border-line px-5 py-4">
      <h2 class="font-display text-lg font-bold text-ink">Ranglijst</h2>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full min-w-[680px] text-sm">
        <thead>
          <tr class="border-b border-line text-left text-xs uppercase tracking-wide text-faint">
            <th class="px-5 py-2.5 font-semibold">#</th>
            <th class="px-3 py-2.5 font-semibold">Camping</th>
            <th class="px-3 py-2.5 text-right font-semibold">L/gast</th>
            <th class="px-3 py-2.5 text-right font-semibold">Verbruik/wk</th>
            <th class="px-3 py-2.5 text-right font-semibold">Bezetting</th>
            <th class="px-5 py-2.5 text-right font-semibold">Bezoekers</th>
          </tr>
        </thead>
        <tbody id="rankBody"></tbody>
      </table>
    </div>
  </section>
</AppLayout>

<script>
  import { ensureLoaded, benchmark, campingWeekly, roleScope, fmt1, fmtInt, fmtPct } from '../lib/store';
  import { renderBarChart, renderAreaChart } from '../lib/charts';
  import { effColor, effLabel } from '../lib/ui';

  function render() {
    const rows = benchmark();
    const mineId = roleScope().campingId;
    const set = (id: string, v: string) => { const el = document.getElementById(id); if (el) el.textContent = v; };

    const best = rows[0];
    const totVerbruik = rows.reduce((s, r) => s + r.verbruikGem * campingWeekly(r.camping.id).length, 0);
    const totBez = rows.reduce((s, r) => s + r.bezoekersTotaal, 0);
    const avgLpb = totBez ? (rows.reduce((s, r) => s + r.literPerBezoeker * r.bezoekersTotaal, 0) / totBez) : 0;

    if (best) {
      set('a-best', best.camping.naam.replace('Minicamping ', '').replace('Boerderijcamping ', ''));
      set('a-best-sub', `${fmtInt(best.literPerBezoeker)} L per gast · ${best.camping.plaats}`);
    }
    set('a-avg', fmtInt(avgLpb));
    set('a-tot', fmt1(totVerbruik));
    set('a-bez', fmtInt(totBez));

    // benchmark bars
    renderBarChart(
      document.getElementById('benchChart')!,
      rows.map((r) => ({
        label: r.camping.naam.replace('Minicamping ', '').replace('Boerderijcamping ', '') + (r.camping.id === mineId ? ' (jij)' : ''),
        sub: `${r.camping.plaats} · ${effLabel(r.literPerBezoeker)}`,
        value: Math.round(r.literPerBezoeker),
        color: effColor(r.literPerBezoeker),
      })),
      { horizontal: true, valueFmt: (v) => `${fmtInt(v)} L` },
    );

    // small multiples
    const sm = document.getElementById('smallMultiples')!;
    sm.innerHTML = rows
      .map((r) => `<div class="card p-4" data-c="${r.camping.id}">
        <div class="flex items-center justify-between">
          <p class="text-sm font-bold text-deep">${r.camping.naam.replace('Minicamping ', '').replace('Boerderijcamping ', '')}</p>
          <span class="tnum text-xs font-bold" style="color:${effColor(r.literPerBezoeker)}">${fmtInt(r.literPerBezoeker)} L/gast</span>
        </div>
        <div class="mt-2 sm-chart"></div>
      </div>`)
      .join('');
    rows.forEach((r) => {
      const el = sm.querySelector(`[data-c="${r.camping.id}"] .sm-chart`) as HTMLElement;
      const weekly = campingWeekly(r.camping.id);
      renderAreaChart(el, weekly.map((w) => ({ label: `${w.week}`, value: w.verbruik })), {
        color: '#2563eb', height: 130, unit: ' m³', valueFmt: fmt1,
      });
    });

    // ranking
    const body = document.getElementById('rankBody')!;
    body.innerHTML = rows
      .map((r, i) => `<tr class="border-b border-line-soft last:border-0 ${r.camping.id === mineId ? 'bg-[var(--color-accent-soft)]' : ''}">
        <td class="px-5 py-3"><span class="grid h-6 w-6 place-items-center rounded-full text-xs font-bold ${i === 0 ? 'bg-good-soft text-good' : 'bg-line-soft text-muted'}">${i + 1}</span></td>
        <td class="px-3 py-3"><span class="font-semibold text-deep">${r.camping.naam}${r.camping.id === mineId ? ' <span class="text-[10px] font-bold uppercase tracking-wide text-ink-3">· jij</span>' : ''}</span><span class="block text-xs text-faint">${r.camping.plaats}</span></td>
        <td class="px-3 py-3 text-right tnum font-bold" style="color:${effColor(r.literPerBezoeker)}">${fmtInt(r.literPerBezoeker)}</td>
        <td class="px-3 py-3 text-right tnum text-deep">${fmt1(r.verbruikGem)} m³</td>
        <td class="px-3 py-3 text-right tnum text-deep">${fmtPct(r.bezettingGem)}</td>
        <td class="px-5 py-3 text-right tnum text-deep">${fmtInt(r.bezoekersTotaal)}</td>
      </tr>`)
      .join('');
  }

  ensureLoaded().then(() => {
    render();
    window.addEventListener('peil:change', render);
  });
</script>
