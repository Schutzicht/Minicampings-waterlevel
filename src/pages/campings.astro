---
import AppLayout from '../layouts/AppLayout.astro';
---
<AppLayout
  active="campings"
  eyebrow="Locaties"
  title="Campings"
  subtitle="De aangesloten minicampings in de regio. Klik een camping aan voor de volledige weekhistorie en grafieken."
>
  <div id="campingGrid" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3"></div>
</AppLayout>

<script>
  import { campingSummaries, fmt1, fmtInt, fmtPct } from '../lib/store';
  import { sparklineSVG } from '../lib/charts';
  import { effColor, effLabel, sparkSafeImg, miniBar } from '../lib/ui';

  function render() {
    const grid = document.getElementById('campingGrid')!;
    grid.innerHTML = campingSummaries().map((s) => `
      <a href="/camping?c=${s.camping.slug}" class="card reveal is-in group overflow-hidden transition-shadow hover:shadow-lift">
        <div class="relative h-36 w-full overflow-hidden water-grad">
          ${sparkSafeImg(s.camping.cover, s.camping.naam)}
          <div class="absolute inset-0" style="background:linear-gradient(180deg,rgba(8,39,48,0) 40%,rgba(8,39,48,.6))"></div>
          <span class="absolute left-3 top-3 chip ${s.submittedThisWeek ? 'bg-good text-white' : 'bg-warn text-white'}">
            ${s.submittedThisWeek ? 'Deze week bij' : 'Deze week open'}
          </span>
          <div class="absolute bottom-3 left-3 right-3 text-white">
            <p class="font-display text-lg font-bold leading-tight drop-shadow">${s.camping.naam}</p>
            <p class="text-xs text-white/85">${s.camping.plaats} · ${s.camping.pitches} plekken</p>
          </div>
        </div>
        <div class="p-4">
          <div class="grid grid-cols-3 gap-2 text-center">
            <div><p class="text-[0.68rem] text-faint">Verbruik</p><p class="tnum text-base font-bold text-deep">${fmt1(s.verbruikWeek)}</p><p class="text-[0.6rem] text-faint">m³/wk</p></div>
            <div><p class="text-[0.68rem] text-faint">L/gast</p><p class="tnum text-base font-bold" style="color:${effColor(s.literPerBezoeker)}">${fmtInt(s.literPerBezoeker)}</p><p class="text-[0.6rem]" style="color:${effColor(s.literPerBezoeker)}">${effLabel(s.literPerBezoeker)}</p></div>
            <div><p class="text-[0.68rem] text-faint">Bezetting</p><p class="tnum text-base font-bold text-deep">${fmtPct(s.bezettingsgraad)}</p><p class="text-[0.6rem] text-faint">vol</p></div>
          </div>
          <div class="mt-3">${miniBar(s.bezettingsgraad)}</div>
          <div class="mt-3 flex items-center justify-between border-t border-line-soft pt-3">
            <span class="text-xs font-semibold text-faint">Verbruik laatste weken</span>
            ${sparklineSVG(s.spark, { w: 110, h: 30, color: '#2563eb' })}
          </div>
        </div>
      </a>`).join('');
  }

  render();
  window.addEventListener('peil:change', render);
</script>
