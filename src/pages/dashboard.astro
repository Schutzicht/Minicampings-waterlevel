---
import AppLayout from '../layouts/AppLayout.astro';
import Icon from '../components/Icon.astro';

const kpis = [
  { id: 'verbruik', label: 'Waterverbruik', unit: 'm³', sub: 'regio totaal' },
  { id: 'lpb', label: 'Liter per gast', unit: 'L', sub: 'gemiddeld' },
  { id: 'bezetting', label: 'Bezetting', unit: '%', sub: 'gemiddeld' },
  { id: 'bezoekers', label: 'Bezoekers', unit: '', sub: 'regio totaal' },
];
---
<AppLayout
  active="dashboard"
  eyebrow="Overzicht"
  title="Dashboard"
  subtitle="Het waterverbruik van alle aangesloten minicampings, afgezet tegen bezoekers en bezetting. Cijfers tonen de laatste volledige week."
>
  <a slot="actions" href="/invoer" class="btn btn-primary px-3.5 py-2 text-sm">
    <Icon name="invoer" size={17} /> <span class="hidden sm:inline">Nieuwe invoer</span><span class="sm:hidden">Invoer</span>
  </a>

  <!-- KPI's -->
  <section class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
    {kpis.map((k) => (
      <div class="card reveal p-4 sm:p-5">
        <div class="flex items-center justify-between">
          <p class="text-sm font-semibold text-muted">{k.label}</p>
          <span id={`kpi-${k.id}-trend`}></span>
        </div>
        <p class="mt-2.5 flex items-baseline gap-1">
          <span id={`kpi-${k.id}`} class="tnum font-display text-3xl font-extrabold text-ink sm:text-[2.1rem]">–</span>
          <span class="text-sm font-semibold text-faint">{k.unit}</span>
        </p>
        <p class="mt-1 text-xs text-faint"><span>{k.sub}</span><span id={`kpi-${k.id}-wk`}></span></p>
      </div>
    ))}
  </section>

  <!-- Chart + deze week -->
  <section class="mt-4 grid gap-4 lg:grid-cols-3">
    <div class="card reveal p-5 lg:col-span-2">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 class="font-display text-lg font-bold text-ink">Verloop per week</h2>
          <p class="text-xs text-faint">Hele regio · laatste 10 weken</p>
        </div>
        <div class="flex rounded-xl bg-line-soft p-1 text-xs font-semibold" role="tablist">
          <button data-metric="verbruik" class="metric-btn rounded-lg px-3 py-1.5">Verbruik</button>
          <button data-metric="bezoekers" class="metric-btn rounded-lg px-3 py-1.5">Bezoekers</button>
          <button data-metric="bezetting" class="metric-btn rounded-lg px-3 py-1.5">Bezetting</button>
        </div>
      </div>
      <div id="regionChart" class="mt-4"></div>
      <p id="regionFoot" class="mt-2 text-xs text-faint"></p>
    </div>

    <div class="card reveal flex flex-col p-5">
      <div class="flex items-center justify-between">
        <h2 class="font-display text-lg font-bold text-ink">Deze week</h2>
        <span id="weekRange" class="chip bg-mist text-brand"></span>
      </div>
      <div class="mt-4 flex items-center gap-4">
        <div id="weekRing"></div>
        <div>
          <p id="weekFrac" class="tnum font-display text-2xl font-extrabold text-ink">–</p>
          <p class="text-xs text-faint">campings ingevuld</p>
        </div>
      </div>
      <div id="weekOpen" class="mt-4 space-y-2"></div>
    </div>
  </section>

  <!-- Per camping -->
  <section class="mt-7 reveal">
    <div class="mb-3 flex items-end justify-between">
      <h2 class="font-display text-lg font-bold text-ink">Per camping</h2>
      <a href="/analyse" class="inline-flex items-center gap-1 text-sm font-semibold text-brand hover:underline">
        Vergelijk locaties <Icon name="right" size={15} />
      </a>
    </div>
    <div id="campingList" class="space-y-3"></div>
  </section>
</AppLayout>

<style>
  .metric-btn { color: var(--color-muted); transition: all .2s; }
  .metric-btn[aria-selected='true'] { background: #fff; color: var(--color-brand); box-shadow: 0 1px 3px rgba(8,39,48,.12); }
</style>

<script>
  import {
    regionWeeklyTotals, getCampings, campingSummaries, currentWeekStatus,
    weekRangeLabel, fmtInt, fmt1, fmtM3, fmtPct,
  } from '../lib/store';
  import { renderAreaChart } from '../lib/charts';
  import { trendBadge, miniBar, effColor, sparkSafeImg } from '../lib/ui';
  import { sparklineSVG } from '../lib/charts';

  function pct(curr: number, prev: number): number | null {
    return prev ? ((curr - prev) / prev) * 100 : null;
  }

  function render() {
    const totals = regionWeeklyTotals();
    const totalCampings = getCampings().length;
    // laatste volledige week (alle campings ingevuld)
    let li = totals.length - 1;
    while (li > 0 && totals[li].campings < totalCampings) li--;
    const last = totals[li];
    const prev = totals[li - 1];

    const lpb = (p?: typeof last) => (p && p.bezoekers ? (p.verbruik * 1000) / p.bezoekers : 0);

    const set = (id: string, val: string) => { const el = document.getElementById(id); if (el) el.textContent = val; };
    const html = (id: string, val: string) => { const el = document.getElementById(id); if (el) el.innerHTML = val; };

    if (last) {
      set('kpi-verbruik', fmt1(last.verbruik));
      html('kpi-verbruik-trend', trendBadge(prev ? pct(last.verbruik, prev.verbruik) : null, 'neutral'));
      set('kpi-lpb', fmtInt(lpb(last)));
      html('kpi-lpb-trend', trendBadge(prev ? pct(lpb(last), lpb(prev)) : null, 'lowerBetter'));
      set('kpi-bezetting', fmtInt(last.bezettingsgraad));
      html('kpi-bezetting-trend', trendBadge(prev ? pct(last.bezettingsgraad, prev.bezettingsgraad) : null, 'higherBetter'));
      set('kpi-bezoekers', fmtInt(last.bezoekers));
      html('kpi-bezoekers-trend', trendBadge(prev ? pct(last.bezoekers, prev.bezoekers) : null, 'higherBetter'));
      const wk = ` · week ${last.week}`;
      ['verbruik', 'lpb', 'bezetting', 'bezoekers'].forEach((id) => set(`kpi-${id}-wk`, wk));
    }

    // ---- chart met metric-switch ----
    const chartEl = document.getElementById('regionChart')!;
    const footEl = document.getElementById('regionFoot')!;
    const metrics = {
      verbruik: { series: totals.map((t) => ({ label: `wk ${t.week}`, value: t.verbruik })), unit: ' m³', color: '#0e7c86', foot: 'Totaal waterverbruik van alle campings samen, per week.' },
      bezoekers: { series: totals.map((t) => ({ label: `wk ${t.week}`, value: t.bezoekers })), unit: '', color: '#38bdf8', foot: 'Aantal bezoekers in de regio, per week.' },
      bezetting: { series: totals.map((t) => ({ label: `wk ${t.week}`, value: t.bezettingsgraad })), unit: '%', color: '#2fa36b', foot: 'Gemiddelde bezettingsgraad over alle campings, per week.' },
    } as const;
    let activeMetric: keyof typeof metrics = 'verbruik';
    const drawChart = () => {
      const m = metrics[activeMetric];
      renderAreaChart(chartEl, m.series, { color: m.color, unit: m.unit, height: 250, valueFmt: (v) => (activeMetric === 'verbruik' ? fmt1(v) : fmtInt(v)) });
      footEl.textContent = m.foot;
      document.querySelectorAll<HTMLButtonElement>('.metric-btn').forEach((b) =>
        b.setAttribute('aria-selected', String(b.dataset.metric === activeMetric)),
      );
    };
    document.querySelectorAll<HTMLButtonElement>('.metric-btn').forEach((b) =>
      b.addEventListener('click', () => { activeMetric = b.dataset.metric as keyof typeof metrics; drawChart(); }),
    );
    drawChart();

    // ---- deze week ----
    const status = currentWeekStatus();
    set('weekRange', weekRangeLabel(status.jaar, status.week));
    const done = status.ingevuld.length;
    const total = done + status.open.length;
    set('weekFrac', `${done}/${total}`);
    // ring
    const p = total ? done / total : 0;
    const r = 26, c = 2 * Math.PI * r;
    html('weekRing', `<svg width="68" height="68" viewBox="0 0 68 68">
      <circle cx="34" cy="34" r="${r}" fill="none" stroke="#e6eef0" stroke-width="7"/>
      <circle cx="34" cy="34" r="${r}" fill="none" stroke="#0e7c86" stroke-width="7" stroke-linecap="round"
        stroke-dasharray="${c}" stroke-dashoffset="${c * (1 - p)}" transform="rotate(-90 34 34)"/>
      <text x="34" y="39" text-anchor="middle" font-size="17" font-weight="800" fill="#082730" font-family="Inter Tight">${Math.round(p * 100)}<tspan font-size="10">%</tspan></text>
    </svg>`);

    const openEl = document.getElementById('weekOpen')!;
    if (status.open.length === 0) {
      openEl.innerHTML = `<div class="flex items-center gap-2 rounded-xl bg-good-soft px-3 py-2.5 text-sm font-semibold text-good">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8.5 12.2l2.4 2.4 4.6-5"/></svg>
        Alle campings hebben deze week ingevuld</div>`;
    } else {
      openEl.innerHTML = `<p class="text-xs font-semibold uppercase tracking-wider text-faint">Nog open</p>` +
        status.open.map((s) => `
        <a href="/invoer?camping=${s.camping.slug}" class="flex items-center justify-between rounded-xl border border-line px-3 py-2 transition-colors hover:border-brand-400 hover:bg-mist">
          <span class="flex items-center gap-2 text-sm font-semibold text-deep"><span class="h-2 w-2 rounded-full bg-warn"></span>${s.camping.naam.replace('Minicamping ', '').replace('Boerderijcamping ', '')}</span>
          <span class="text-xs font-semibold text-brand">Invullen</span>
        </a>`).join('');
    }

    // ---- per camping ----
    const list = document.getElementById('campingList')!;
    const summaries = campingSummaries();
    list.innerHTML = summaries.map((s) => {
      const naam = s.camping.naam;
      return `
      <a href="/camping?c=${s.camping.slug}" class="card group flex flex-col gap-4 p-4 transition-shadow hover:shadow-soft sm:flex-row sm:items-center">
        <div class="flex items-center gap-3 sm:w-60 sm:shrink-0">
          <span class="water-grad relative grid h-12 w-12 shrink-0 place-items-center overflow-hidden rounded-xl">
            ${sparkSafeImg(s.camping.cover, naam)}
          </span>
          <span class="min-w-0">
            <span class="block truncate font-semibold text-ink">${naam}</span>
            <span class="block text-xs text-faint">${s.camping.plaats} · ${s.camping.pitches} plekken</span>
          </span>
        </div>
        <div class="grid flex-1 grid-cols-3 gap-3 sm:max-w-sm">
          <div><p class="text-[0.7rem] text-faint">Verbruik</p><p class="tnum text-sm font-bold text-deep">${fmt1(s.verbruikWeek)}<span class="text-[0.65rem] font-medium text-faint"> m³</span></p></div>
          <div><p class="text-[0.7rem] text-faint">L/gast</p><p class="tnum text-sm font-bold" style="color:${effColor(s.literPerBezoeker)}">${fmtInt(s.literPerBezoeker)}</p></div>
          <div><p class="text-[0.7rem] text-faint">Bezetting</p><p class="tnum text-sm font-bold text-deep">${fmtPct(s.bezettingsgraad)}</p></div>
        </div>
        <div class="hidden sm:block sm:w-28">${sparklineSVG(s.spark, { w: 112, h: 34, color: '#0e7c86' })}</div>
        <div class="flex items-center gap-2 sm:w-28 sm:justify-end">
          <span class="chip ${s.submittedThisWeek ? 'bg-good-soft text-good' : 'bg-warn-soft text-warn'}">
            <span class="h-1.5 w-1.5 rounded-full ${s.submittedThisWeek ? 'bg-good' : 'bg-warn'}"></span>
            ${s.submittedThisWeek ? 'Bij' : 'Open'}
          </span>
          <svg class="text-faint transition-transform group-hover:translate-x-0.5" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
        </div>
      </a>`;
    }).join('');
  }

  render();
  window.addEventListener('peil:change', render);
</script>
